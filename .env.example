# ============================================================
# Claude Discord Relay — Environment Variables
# ============================================================
# Copy to .env:  cp .env.example .env
# Then fill in your values below.
# ============================================================

# --- REQUIRED: Discord ---

# Bot token from Discord Developer Portal
# (https://discord.com/developers/applications → your app → Bot → Token)
DISCORD_BOT_TOKEN=your_bot_token_from_discord

# Your Discord user ID
# (Enable Developer Mode in Discord Settings → Advanced,
#  then right-click your name → Copy User ID)
DISCORD_USER_ID=your_discord_user_id

# --- REQUIRED: Supabase (persistent memory) ---

# Project URL (looks like https://abc123.supabase.co)
SUPABASE_URL=your_project_url

# anon public key (starts with eyJ...)
SUPABASE_ANON_KEY=your_anon_key

# --- RECOMMENDED: Personalization ---

# Your first name
USER_NAME=Your Name

# Your timezone (IANA format: America/New_York, Europe/Berlin, etc.)
USER_TIMEZONE=UTC

# --- OPTIONAL: ClickUp Task Management ---

# Personal API token from ClickUp Settings → Apps
# CLICKUP_API_KEY=pk_your_clickup_api_key

# The list ID where tasks live
# (ClickUp → open a list → the URL has /list/XXXXXX)
# CLICKUP_LIST_ID=your_list_id

# --- OPTIONAL: Paths ---

# Claude CLI path (auto-detected if in PATH)
# CLAUDE_PATH=claude

# Working directory for Claude (defaults to relay's own directory)
# PROJECT_DIR=/path/to/your/project

# Relay data directory (defaults to ~/.claude-relay)
# RELAY_DIR=~/.claude-relay
